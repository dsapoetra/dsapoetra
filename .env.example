# Copy to .env.local for development. NEVER commit .env.local, and never paste
# any of these values into a chat, an issue, or a commit message.
#
# For production, set them on Vercel rather than in a file:
#   vercel env add <NAME> production
#
# None of these carry a NEXT_PUBLIC_ prefix, and none of them may. A
# NEXT_PUBLIC_ variable is inlined into the browser bundle, where a secret key
# would let anyone forge a payment notification or mint their own download link.


# ── DOKU — payments ─────────────────────────────────────────────
# https://dashboard.doku.com — separate key pairs for sandbox and production.

DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# "sandbox" (default) or "production". Leave on sandbox until a full test
# payment has gone through end to end.
DOKU_ENV=sandbox


# ── Download links ──────────────────────────────────────────────
# Signs the private download links in the receipt email. Its own secret, NOT
# the DOKU one: rotating the DOKU key would otherwise invalidate every download
# link already sitting in a buyer's inbox.
#
# Generate with:  openssl rand -base64 32
DOWNLOAD_SECRET=


# ── Resend — the receipt email ──────────────────────────────────
# Provisioned through the Vercel Marketplace, which sets RESEND_API_KEY for you.

RESEND_API_KEY=

# Sender address. MUST be on a domain verified in Resend — an unverified sender
# is accepted by the API and then quietly fails to arrive.
SHOP_FROM_EMAIL="dsapoetra <toko@dsapoetra.com>"

# Where a buyer's reply goes. Optional; falls back to the from address.
SHOP_REPLY_TO=


# ── Upstash Redis — order storage ───────────────────────────────
# Set automatically by the Vercel Marketplace integration; pull them with
# `vercel env pull`. Listed here so the names are documented, not to be filled
# in by hand.
#   KV_REST_API_URL
#   KV_REST_API_TOKEN
